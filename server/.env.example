# install.sh legt .env automatisch an und fragt die Werte ab. Diese Datei ist nur die Referenz.
DOMAIN=stream.example.org
PUBLIC_IP=203.0.113.10
# Name der Website (Titel, Kopfzeile)
SITE_NAME=Mein Stream
# Docker-Compose-Subnetz, aus dem der MediaMTX-Auth-Hook kommen darf (siehe docker-compose.yml)
HOOK_SUBNET=172.30.0.0/24
# wird von install.sh per openssl erzeugt (reserviert)
SESSION_SECRET=
